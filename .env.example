# ===================== DORAMA STUDIO IA — Variables de entorno =====================
# Copia a .env y rellena. Los adapters leen estas claves via os.getenv.
# Las API keys solo se necesitan cuando se ejecuta ese proveedor concreto.

# --- LLM (narrative score/fast via Anthropic por defecto) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Imagen: caracter principal Imagen 3; fallback Flux (Replicate) / DALL-E ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
REPLICATE_API_TOKEN=

# --- Video: Kling -> Runway -> Veo -> Hailuo (fallback chain) ---
KLING_API_KEY=
RUNWAY_API_KEY=
HAILUO_API_KEY=

# --- Voz: ElevenLabs v3 ---
ELEVENLABS_API_KEY=

# --- Musica: Suno (generativa) + Epidemic Sound (libreria licenciada) ---
SUNO_API_KEY=
EPIDEMIC_SOUND_API_KEY=
ARTLIST_API_KEY=

# --- Publicacion (Multi-Platform Publisher) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# --- Storage (opcional; si no, usa checkpoints locales SQLite) ---
SUPABASE_URL=
SUPABASE_KEY=
REDIS_URL=redis://localhost:6379/0